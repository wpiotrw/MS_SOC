// title: Credential deletions that are not followed by a re-registration
// date: 2026-08-31
// product: Entra
// tables: AuditLogs
// purpose: Authentication-method deletions with no re-registration by the same user afterwards.
// source: https://learn.microsoft.com/azure/azure-monitor/reference/tables/auditlogs
// Authentication-method deletions with no re-registration by the same user afterwards.
// Schema: AuditLogs — learn.microsoft.com/azure/azure-monitor/reference/tables/auditlogs
let Window = 30d;
let Deletions =
    AuditLogs
    | where TimeGenerated > ago(Window)
    | where Category == "UserManagement" or LoggedByService has "Authentication Methods"
    | where OperationName has_any ("Delete", "Remove") and OperationName has_any ("method", "Method")
    | extend TargetUpn = tostring(TargetResources[0].userPrincipalName)
    | extend ActorApp  = tostring(InitiatedBy.app.displayName)
    | extend ActorUser = tostring(InitiatedBy.user.userPrincipalName)
    | project DeleteTime = TimeGenerated, TargetUpn, OperationName, ActorApp, ActorUser, Result;
let Registrations =
    AuditLogs
    | where TimeGenerated > ago(Window)
    | where OperationName has_any ("Register", "Add") and OperationName has_any ("method", "Method", "security info")
    | extend TargetUpn = tostring(TargetResources[0].userPrincipalName)
    | project RegTime = TimeGenerated, TargetUpn;
Deletions
| join kind=leftouter Registrations on TargetUpn
| summarize LastReg = maxif(RegTime, RegTime > DeleteTime) by DeleteTime, TargetUpn, OperationName, ActorApp, ActorUser, Result
| where isnull(LastReg)
| order by DeleteTime desc
