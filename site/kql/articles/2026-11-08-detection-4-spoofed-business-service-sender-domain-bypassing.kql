// title: Detection 4: Spoofed Business-Service Sender Domain Bypassing Email Authentication Controls
// date: 2026-11-08
// product: Defender for Office 365
// tables: EmailEvents
// purpose: From the article: Detection Engineering Brief - Sunday, November 8, 2026
// source: https://devsecopsdadattack.com/2026-11-08-detection-engineering-brief-sunday-november-8-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let BusinessServiceKeywords = dynamic(["docusign", "sharepoint", "onedrive", "dropbox", "adobe", "zoom", "teams", "salesforce", "servicenow", "workday", "paypal", "microsoft", "google"]);
EmailEvents
| where Timestamp > ago(1d)
| where DeliveryAction == "Delivered"
| where isnotempty(AuthenticationDetails)
| extend AuthParsed = todynamic(AuthenticationDetails)
| extend SpfVerdict = tostring(AuthParsed.SPF)
| extend DkimVerdict = tostring(AuthParsed.DKIM)
| extend DmarcVerdict = tostring(AuthParsed.DMARC)
| where SpfVerdict =~ "Fail" or DkimVerdict =~ "Fail" or DmarcVerdict =~ "Fail"
| extend SenderDomainLower = tolower(SenderMailFromDomain)
| where SenderDomainLower has_any (BusinessServiceKeywords)
| project
    Timestamp,
    SenderFromAddress,
    SenderMailFromDomain,
    RecipientEmailAddress,
    Subject,
    DeliveryAction,
    SpfVerdict,
    DkimVerdict,
    DmarcVerdict,
    SenderIPv4,
    NetworkMessageId
