// title: Detection 3: Storm-0940 M365 Application Credential Abuse via OAuth Service Principal
// date: 2026-10-22
// product: Entra
// tables: AuditLogs, SigninLogs
// purpose: From the article: Detection Engineering Brief - Thursday, October 22, 2026
// source: https://devsecopsdadattack.com/2026-10-22-detection-engineering-brief-thursday-october-22-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let CredentialAdditions = AuditLogs
| where TimeGenerated >= ago(1d)
| where OperationName in (
    "Add service principal credentials",
    "Update application – Certificates and secrets management",
    "Add application"
    )
| where Result == "success"
| extend
    AppId = tostring(TargetResources[0].id),
    AppName = tostring(TargetResources[0].displayName),
    InitiatedByUPN = tostring(InitiatedBy.user.userPrincipalName),
    InitiatedByIP = tostring(InitiatedBy.user.ipAddress),
    InitiatedByApp = tostring(InitiatedBy.app.displayName)
| where isnotempty(AppId)
| project CredentialAddTime = TimeGenerated, AppId, AppName, InitiatedByUPN, InitiatedByIP, InitiatedByApp;
let AppSignins = SigninLogs
| where TimeGenerated >= ago(1d)
| where TokenIssuerType == "AzureAD"
| where isnotempty(AppId)
| where ResultType == 0
| project
    SigninTime = TimeGenerated,
    AppId,
    AppDisplayName,
    UserPrincipalName,
    IPAddress,
    ResultType,
    RiskLevelDuringSignIn,
    ConditionalAccessStatus,
    UserAgent;
CredentialAdditions
| join kind=inner AppSignins on AppId
| where SigninTime between (CredentialAddTime .. (CredentialAddTime + 2h))
| project
    CredentialAddTime,
    SigninTime,
    AppName,
    AppDisplayName,
    InitiatedByUPN,
    InitiatedByApp,
    InitiatedByIP,
    UserPrincipalName,
    IPAddress,
    ResultType,
    RiskLevelDuringSignIn,
    ConditionalAccessStatus,
    UserAgent
| order by CredentialAddTime desc
