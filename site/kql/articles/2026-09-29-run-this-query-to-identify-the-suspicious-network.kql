// title: // Run this query to identify the suspicious network connections from the threat actor’s use of ScreenConnect
// date: 2026-09-29
// product: Defender for Endpoint
// tables: DeviceNetworkEvents
// purpose: From the article: Phishing Abuses RMM Tools for Persistent Access
// source: https://www.microsoft.com/en-us/security/blog/2026/09/29/phishing-abuses-rmm-tools-persistent-access/
// kind: article
// author: Microsoft Security Research, Parasharan Raghavan, Deva Kanna Kannan, Sai Chakri and Microsoft Defender Experts · Microsoft Threat Intelligence
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let MaliciousURLs =  DeviceNetworkEvents
| where Timestamp >= ago(30d)
| where InitiatingProcessCommandLine == "\"powershell.exe\""
| where InitiatingProcessParentFileName == "RMM.Agent.exe"
| where isnotempty(RemoteUrl)
| distinct  RemoteUrl;
DeviceNetworkEvents
| where Timestamp >= ago(30d)
| where InitiatingProcessFileName has_any ( "ScreenConnect.ClientService.exe","ScreenConnect.WindowsClient.exe","ScreenConnect.Client.exe")
| where isnotempty(RemoteUrl)
| where RemoteUrl in (MaliciousURLs)
