// title: Detection 1: PHP Worker Process Spawning Unexpected Shell or Interpreter
// date: 2026-10-22
// product: Defender for Endpoint
// tables: DeviceProcessEvents
// purpose: From the article: Detection Engineering Brief - Thursday, October 22, 2026
// source: https://devsecopsdadattack.com/2026-10-22-detection-engineering-brief-thursday-october-22-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let PhpWorkerParents = dynamic(["php-fpm", "php-cgi", "apache2", "httpd", "litespeed", "frankenphp"]);
let SuspiciousChildren = dynamic(["sh", "bash", "dash", "zsh", "ksh", "python", "python3", "perl", "ruby", "nc", "ncat", "curl", "wget", "cmd.exe", "powershell.exe"]);
DeviceProcessEvents
| where Timestamp >= ago(7d)
| where InitiatingProcessFileName in~ (PhpWorkerParents)
| where FileName in~ (SuspiciousChildren)
| where FileName !~ InitiatingProcessFileName
| project
    Timestamp,
    DeviceName,
    AccountName,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    InitiatingProcessParentFileName,
    InitiatingProcessId,
    FileName,
    ProcessCommandLine,
    ProcessId
| order by Timestamp desc
