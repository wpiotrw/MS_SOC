// title: Detection 2: Python Process Outbound Connection During Package Import - Remote Code Loading
// date: 2026-10-25
// product: Defender for Endpoint
// tables: DeviceNetworkEvents
// purpose: From the article: Detection Engineering Brief - Sunday, October 25, 2026
// source: https://devsecopsdadattack.com/2026-10-25-detection-engineering-brief-sunday-october-25-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceNetworkEvents
| where Timestamp > ago(7d)
| where ActionType == "ConnectionSuccess"
| where InitiatingProcessFileName in~ ("python", "python3", "python.exe", "python3.exe")
| where InitiatingProcessParentFileName in~ ("pip", "pip3", "pip.exe", "pip3.exe", "python", "python3", "python.exe", "python3.exe")
| where RemotePort !in (80, 443, 8080, 8443)
| where not(ipv4_is_private(RemoteIP))
| where RemoteIP != "127.0.0.1"
| project
    Timestamp,
    DeviceName,
    InitiatingProcessFileName,
    InitiatingProcessParentFileName,
    InitiatingProcessCommandLine,
    InitiatingProcessId,
    RemoteIP,
    RemotePort
| order by Timestamp desc
