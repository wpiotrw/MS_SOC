// title: Detection 5: GraphDoor Backdoor - Cloud API Access from Non-Standard Process (Operation ShadowCloud)
// date: 2026-11-17
// product: Defender for Endpoint
// tables: DeviceFileEvents, DeviceNetworkEvents
// purpose: From the article: Detection Engineering Brief - Tuesday, November 17, 2026
// source: https://devsecopsdadattack.com/2026-11-17-detection-engineering-brief-tuesday-november-17-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let CloudC2 = DeviceNetworkEvents
| where Timestamp > ago(24h)
| where RemoteUrl has_any (
    "graph.microsoft.com",
    "graph.windows.net",
    "onedrive.live.com",
    "sharepoint.com",
    "1drv.ms"
  )
| where InitiatingProcessFileName !in~ (
    "onedrive.exe", "OneDriveSetup.exe",
    "Teams.exe", "ms-teams.exe",
    "outlook.exe", "olk.exe",
    "msedge.exe", "chrome.exe", "firefox.exe",
    "MicrosoftEdgeUpdate.exe",
    "svchost.exe",
    "powershell.exe", "pwsh.exe",
    "MicrosoftTeams.exe"
  )
| project
    C2Time = Timestamp,
    DeviceName,
    InitiatingProcessFileName,
    InitiatingProcessFolderPath,
    InitiatingProcessSHA256,
    RemoteUrl;
let PluginLoad = DeviceFileEvents
| where Timestamp > ago(24h)
| where ActionType in ("FileCreated", "FileModified")
| where FolderPath has_any (
    "\\Temp\\",
    "\\AppData\\Local\\",
    "\\AppData\\Roaming\\",
    "\\ProgramData\\"
  )
| where FolderPath !has "\\Microsoft\\Windows\\INetCache\\"
| where FileName endswith ".dll"
    or FileName endswith ".dat"
    or FileName endswith ".bin"
| project
    FileTime = Timestamp,
    DeviceName,
    InitiatingProcessFileName,
    InitiatingProcessFolderPath,
    FileName,
    FolderPath,
    ActionType;
CloudC2
| join kind=inner PluginLoad on DeviceName, InitiatingProcessFileName
| where FileTime between (C2Time .. (C2Time + 1h))
| project
    C2Time,
    FileTime,
    DeviceName,
    InitiatingProcessFileName,
    InitiatingProcessFolderPath,
    InitiatingProcessSHA256,
    RemoteUrl,
    FileName,
    FolderPath,
    ActionType
| order by C2Time desc
