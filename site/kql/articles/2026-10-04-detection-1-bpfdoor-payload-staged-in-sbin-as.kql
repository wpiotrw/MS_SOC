// title: Detection 1: BPFDoor - Payload Staged in /sbin as ntpdate or udevds
// date: 2026-10-04
// product: Defender for Endpoint
// tables: DeviceFileEvents
// purpose: From the article: Detection Engineering Brief - Sunday, October 4, 2026
// source: https://devsecopsdadattack.com/2026-10-04-detection-engineering-brief-sunday-october-4-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceFileEvents
| where ActionType == "FileCreated"
| where FolderPath == "/sbin" or FolderPath startswith "/sbin/"
| where FileName in~ ("ntpdate", "udevds")
| where InitiatingProcessFileName !in~ ("apt", "apt-get", "yum", "rpm", "dpkg", "dnf", "zypper", "install", "update-alternatives")
| project Timestamp, DeviceName, FileName, FolderPath, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessAccountName, SHA256, ReportId
