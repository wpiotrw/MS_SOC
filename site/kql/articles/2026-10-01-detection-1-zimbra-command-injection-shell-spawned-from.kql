// title: Detection 1: Zimbra Command Injection - Shell Spawned from Web Service Process (CVE-2026-73570)
// date: 2026-10-01
// product: Defender for Endpoint
// tables: DeviceProcessEvents
// purpose: From the article: Detection Engineering Brief - Thursday, October 1, 2026
// source: https://devsecopsdadattack.com/2026-10-01-detection-engineering-brief-thursday-october-1-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceProcessEvents
| where Timestamp > ago(24h)
| where InitiatingProcessFileName has_any ("java", "jetty", "zimbra", "zmmailboxd", "zmconfigd", "zmlmtpserver")
| where FileName in~ ("bash", "sh", "dash", "python", "python3", "perl", "ruby", "wget", "curl", "nc", "ncat", "netcat")
| project
    Timestamp,
    DeviceName,
    AccountName,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    FileName,
    FolderPath,
    ProcessCommandLine
| order by Timestamp desc
