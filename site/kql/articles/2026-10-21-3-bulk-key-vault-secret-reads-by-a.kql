// title: 3 – Bulk Key Vault secret reads by a single identity across multiple vaults
// date: 2026-10-21
// product: Sentinel
// tables: CloudKeyVaultEvents
// purpose: From the article: AI-driven, large-scale nation-state campaign using ARTEX enables supply chain compromise
// source: https://www.microsoft.com/en-us/security/blog/2026/10/21/storm-0940-uses-artex-agentic-ai-connectwise-supply-chain-compromise/
// kind: article
// author: Microsoft Security Research and Microsoft Threat Intelligence · Microsoft Security Blog
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
CloudKeyVaultEvents
| where Timestamp > ago(14d)
| where ActivityName == "SecretGet" and HttpStatusCode == 200
| summarize SecretGets = count(), VaultCount = dcount(AzureResourceId),
   IPs = make_set(IPAddress, 20)
   by bin(Timestamp, 15m), AccountObjectId, AccountTenantId
| where SecretGets >= 20 and VaultCount >= 3
