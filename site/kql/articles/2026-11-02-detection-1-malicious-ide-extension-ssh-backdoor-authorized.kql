// title: Detection 1: Malicious IDE Extension SSH Backdoor - authorized_keys Modified by Extension Process
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceFileEvents
// purpose: From the article: Detection Engineering Brief - Monday, November 2, 2026
// source: https://devsecopsdadattack.com/2026-11-02-detection-engineering-brief-monday-november-2-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceFileEvents
| where TimeGenerated > ago(7d)
| where ActionType in ("FileCreated", "FileModified", "FileRenamed")
| where (
    FileName in~ ("authorized_keys", "sshd_config")
    or FolderPath has ".ssh"
    or FolderPath has "/etc/ssh"
)
| where (
    InitiatingProcessFileName has_any ("cursor", "node", "electron", "code")
    or InitiatingProcessParentFileName has_any ("cursor", "node", "electron", "code")
)
| project
    TimeGenerated,
    DeviceName,
    FolderPath,
    FileName,
    ActionType,
    InitiatingProcessFileName,
    InitiatingProcessParentFileName,
    InitiatingProcessCommandLine,
    InitiatingProcessAccountName
| order by TimeGenerated desc
