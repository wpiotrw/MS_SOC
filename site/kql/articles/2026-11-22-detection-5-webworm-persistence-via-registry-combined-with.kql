// title: Detection 5: Webworm - Persistence via Registry Combined with Recurring Outbound Encrypted Tunnel Connections
// date: 2026-11-22
// product: Defender for Endpoint
// tables: DeviceNetworkEvents, DeviceRegistryEvents
// purpose: From the article: Detection Engineering Brief - Sunday, November 22, 2026
// source: https://devsecopsdadattack.com/2026-11-22-detection-engineering-brief-sunday-november-22-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let tunnelPorts = dynamic([992, 1194, 5555]);
let persistenceKeys = dynamic([
    "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run",
    "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\RunOnce",
    "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services"
]);
let suspiciousProcs = dynamic(["cmd.exe", "powershell.exe", "wscript.exe", "cscript.exe", "mshta.exe", "rundll32.exe"]);
let lookback = 14d;
let minConnections = 3;
let persistenceEvents =
    DeviceRegistryEvents
    | where TimeGenerated > ago(lookback)
    | where ActionType in ("RegistryValueSet", "RegistryKeyCreated")
    | where RegistryKey has_any (persistenceKeys)
    | where InitiatingProcessFileName in~ (suspiciousProcs)
    | project
        DeviceId,
        DeviceName,
        AccountName,
        PersistTime = TimeGenerated,
        RegistryKey,
        RegistryValueName,
        InitiatingProcessFileName;
let recurringConnections =
    DeviceNetworkEvents
    | where TimeGenerated > ago(lookback)
    | where RemotePort in (tunnelPorts)
    | where (RemoteIPType == "Public") or (isempty(RemoteIPType) and not(ipv4_is_private(RemoteIP)))
    | summarize
        ConnectionCount = count(),
        FirstConn = min(TimeGenerated),
        LastConn = max(TimeGenerated)
        by DeviceId, RemoteIP, RemotePort
    | where ConnectionCount >= minConnections;
persistenceEvents
| join kind=inner recurringConnections on DeviceId
| where FirstConn >= PersistTime
| project
    DeviceId,
    DeviceName,
    AccountName,
    PersistTime,
    RegistryKey,
    RegistryValueName,
    InitiatingProcessFileName,
    RemoteIP,
    RemotePort,
    ConnectionCount,
    FirstConn,
    LastConn
