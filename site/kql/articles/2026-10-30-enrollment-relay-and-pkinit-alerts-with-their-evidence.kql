// title: Enrollment, relay, and PKINIT alerts with their evidence
// date: 2026-10-30
// product: Defender XDR
// tables: AlertEvidence, AlertInfo
// purpose: From the article: From help desk impersonation to AD CS abuse: Investigating ESC1 and ESC8 intrusion paths
// source: https://www.microsoft.com/en-us/security/blog/2026/10/30/help-desk-impersonation-ad-cs-abuse-investigating-esc1-esc8-intrusion-paths/
// kind: article
// author: Microsoft Security Research, Sagar Patil, Jesse Birch and Tal Tzhori · Microsoft Threat Intelligence
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
AlertInfo
| where Timestamp > ago(7d)
| where
    Title contains "NTLM relay"
    or Title contains "Certificate Services"
    or Title contains "PKINIT"
    or Title contains "Kerberos ticket request"
| join kind=inner (
    AlertEvidence
    | where Timestamp > ago(7d)
) on AlertId
