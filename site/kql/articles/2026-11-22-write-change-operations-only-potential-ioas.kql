// title: Write / change operations only (potential IOAs)
// date: 2026-11-22
// product: Entra
// tables: AuditLogs
// purpose: Published for the incident: Microsoft Entra Connect Health API flaw: attackers read administrator emails and tenant metadata (23 Jul - 19 Nov 2026)
// source: https://x.com/ellishlomo
// kind: article
// author: ES (@ellishlomo)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
AuditLogs
| where TimeGenerated between (datetime(2026-07-23) .. datetime(2026-11-19))
| where OperationName has_any ("Add", "Update", "Delete", "Set", "Create", "Remove", "Modify")
| where OperationName has_any ("Connect", "Health", "Hybrid", "servicemember")
   or TargetResources has "ADHybrid"
| extend Actor = tostring(InitiatedBy.user.userPrincipalName)
| project TimeGenerated, OperationName, Actor, Result, TargetResources, AdditionalDetails
| order by TimeGenerated desc
