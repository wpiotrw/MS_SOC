// title: 2. Whose SharePoint does OfficeActivity actually cover?
// date: 2026-11-12
// product: Microsoft 365
// tables: OfficeActivity
// purpose: From the article: KQL Detection of the Week: Two Things Called SharePoint
// source: https://devsecopsdadattack.com/2026-11-12-KQL-Detection-of-the-Week-Two-Things-Called-SharePoint/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// 2. Whose SharePoint does OfficeActivity actually cover?
OfficeActivity
| where TimeGenerated >= ago(7d)
| where OfficeWorkload =~ "SharePoint"
| extend SiteHost = tostring(parse_url(OfficeObjectId).Host)
| summarize Events = count() by SiteHost
| order by Events desc
