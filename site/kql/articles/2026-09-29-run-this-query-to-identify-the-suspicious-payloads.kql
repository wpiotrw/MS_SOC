// title: // Run this query to identify the suspicious payloads dropped and launched by the threat actor’s use of ScreenConnect
// date: 2026-09-29
// product: Defender for Endpoint
// tables: DeviceProcessEvents
// purpose: From the article: Phishing Abuses RMM Tools for Persistent Access
// source: https://www.microsoft.com/en-us/security/blog/2026/09/29/phishing-abuses-rmm-tools-persistent-access/
// kind: article
// author: Microsoft Security Research, Parasharan Raghavan, Deva Kanna Kannan, Sai Chakri and Microsoft Defender Experts · Microsoft Threat Intelligence
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceProcessEvents
| where Timestamp >= ago(30d)
| where InitiatingProcessCommandLine  has_all ("ScreenConnect.WindowsClient.exe", "RunFile","\\Documents\\","\\Temp\\")
