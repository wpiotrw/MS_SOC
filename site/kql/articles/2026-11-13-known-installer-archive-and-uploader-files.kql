// title: Known installer, archive, and uploader files
// date: 2026-11-13
// product: Defender for Endpoint
// tables: DeviceFileEvents
// purpose: From the article: SCKit abuses ScreenConnect to deploy remote access and target technician sessions
// source: https://www.microsoft.com/en-us/security/blog/2026/11/13/sckit-abuses-screenconnect-deploy-remote-access-target-technician-sessions/
// kind: article
// author: Microsoft Security Research, Sagar Patil and Jeremiah Jasmin · Microsoft Security Blog
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceFileEvents
| where Timestamp > ago(14d)
| where SHA1 in~ (
    "0be01e7bd69cfdd222645d49bb5ad9961372fef2",
    "3f81c9c874a896c46e4bccea2fad2eaa3d9f2054",
    "13ce33b19daee3963f7e15d461b191c38f6bc0d3")
| project Timestamp, DeviceId, DeviceName, FileName, FolderPath,
    SHA1, InitiatingProcessFileName, ReportId
