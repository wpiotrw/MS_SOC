// title: Where Dropped Events Leave a Trace
// date: 2026-10-10
// product: 
// tables: 
// purpose: From the article: Before It Reaches Sentinel: How Your Own Pipeline Can Silently Drop Security Evidence
// source: https://detect.fyi/before-it-reaches-sentinel-how-your-own-pipeline-can-silently-drop-security-evidence-e4ab2640249d?source=rss----d5fd8f494f6a---4
// kind: article
// author: Rohitashokgowd · Detect FYI (detection engineering, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
AzureMetrics
| where TimeGenerated > ago(7d)
| where ResourceId has "DATACOLLECTIONRULES"
| where MetricName in ("RowsDropped_Count", "RowsReceived_Count")
| extend DCR = tostring(split(ResourceId, "/")[-1])
| summarize Value = sum(Total) by MetricName, DCR
| evaluate pivot(MetricName, sum(Value))
| extend DropRatePct = round(100.0 * RowsDropped_Count / (RowsReceived_Count + RowsDropped_Count), 1)
| project DCR, RowsReceived_Count, RowsDropped_Count, DropRatePct
| sort by RowsDropped_Count desc
