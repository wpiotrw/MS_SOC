// title: 3. Monitor certificate-based logons
// date: 2026-07-15
// product: Defender for Endpoint
// tables: DeviceLogonEvents
// purpose: From the article: New Privileged Token Context Telemetry Boosts Advanced Hunting in Microsoft Defender
// source: https://techcommunity.microsoft.com/t5/microsoft-defender-xdr-blog/new-privileged-token-context-telemetry-boosts-advanced-hunting/ba-p/4528613
// kind: article
// author: TalTzhori · Microsoft Defender XDR Blog
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let lookback = 14d;
let recent = 1d;
// Baseline: users who historically used certificate-based auth
let baseline_users =
DeviceLogonEvents
| where Timestamp between (ago(lookback) .. ago(recent))
| where AdditionalFields has "TokenHasThisOrgCertificateSid"
| summarize by AccountSid;
// Recent: new certificate-based logons
DeviceLogonEvents
| where Timestamp > ago(recent)
| where AdditionalFields has "TokenHasThisOrgCertificateSid"
| where AccountSid !in (baseline_users)
