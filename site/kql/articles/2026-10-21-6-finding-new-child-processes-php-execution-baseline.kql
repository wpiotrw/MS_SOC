// title: 6. Finding new child processes: PHP execution baseline
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceProcessEvents
// purpose: From the article: PHP2Shell: Two Critical PHP Vulnerabilities (CVE-2026–109618 and CVE-2026–109619) — Are Your…
// source: https://detect.fyi/php2shell-two-critical-php-vulnerabilities-cve-2026-109618-and-cve-2026-109619-are-your-3f0a0c08f6ec?source=rss----d5fd8f494f6a---4
// kind: article
// author: Sergio Albea · Detect FYI (detection engineering, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let WebProcesses = dynamic([
    "php", "php.exe",
    "php-cgi", "php-cgi.exe",
    "php-fpm",
    "apache2", "httpd",
    "nginx", "w3wp.exe"
]);
let Baseline =
    DeviceProcessEvents
    | where Timestamp between (ago(30d) .. ago(2d))
    | where InitiatingProcessFileName in~ (WebProcesses)
        or InitiatingProcessFileName startswith "php-fpm"
    | distinct
        DeviceId,
        InitiatingProcessFileName,
        FileName;
DeviceProcessEvents
| where Timestamp > ago(2d)
| where InitiatingProcessFileName in~ (WebProcesses)
    or InitiatingProcessFileName startswith "php-fpm"
| join kind=leftanti Baseline
    on DeviceId,
       InitiatingProcessFileName,
       FileName
| summarize
    Executions = count(),
    FirstSeen = min(Timestamp),
    LastSeen = max(Timestamp),
    Commands = make_set(ProcessCommandLine, 10)
    by DeviceName,
       InitiatingProcessFileName,
       FileName
| order by Executions asc
