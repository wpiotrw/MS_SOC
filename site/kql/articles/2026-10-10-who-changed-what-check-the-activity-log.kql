// title: Who Changed What? Check the Activity Log
// date: 2026-10-10
// product: Sentinel
// tables: AzureActivity
// purpose: From the article: Before It Reaches Sentinel: How Your Own Pipeline Can Silently Drop Security Evidence
// source: https://detect.fyi/before-it-reaches-sentinel-how-your-own-pipeline-can-silently-drop-security-evidence-e4ab2640249d?source=rss----d5fd8f494f6a---4
// kind: article
// author: Rohitashokgowd · Detect FYI (detection engineering, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
AzureActivity
| where TimeGenerated > ago(1h)
| where ResourceProviderValue == "MICROSOFT.INSIGHTS"
| where OperationNameValue has "dataCollectionRules"
| where OperationNameValue has_any ("write", "delete")
| extend Action = case(
        OperationNameValue has "delete", "Delete",
        OperationNameValue has "write",  "Write",
        "Other"),
    DCR = tostring(Properties_d.resource),
    ResourceGroup = tostring(Properties_d.resourceGroup),
    Subscription = tostring(Properties_d.subscriptionId),
    ActorRole = tostring(Authorization_d.evidence.role),
    Scope = tostring(Authorization_d.evidence.roleAssignmentScope)
| project TimeGenerated,Action,ActivityStatusValue, DCR,ResourceGroup,Caller,CallerIpAddress,ActorRole, Scope,Subscription,CorrelationId
