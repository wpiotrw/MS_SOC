// title: Network activity initiated by the staged runtime
// date: 2026-10-30
// product: Defender for Endpoint
// tables: DeviceNetworkEvents
// purpose: From the article: From help desk impersonation to AD CS abuse: Investigating ESC1 and ESC8 intrusion paths
// source: https://www.microsoft.com/en-us/security/blog/2026/10/30/help-desk-impersonation-ad-cs-abuse-investigating-esc1-esc8-intrusion-paths/
// kind: article
// author: Microsoft Security Research, Sagar Patil, Jesse Birch and Tal Tzhori · Microsoft Threat Intelligence
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceNetworkEvents
| where Timestamp > ago(7d)
| where InitiatingProcessVersionInfoOriginalFileName =~ "bun.exe"
    or InitiatingProcessFileName in~ (
        "bun.exe", "java.exe", "javaw.exe")
| where RemotePort in (80, 445, 636, 88)
| where InitiatingProcessFolderPath matches regex
    @"(?i)\\AppData\\Roaming\\KB[0-9]+\\"
| order by Timestamp desc
