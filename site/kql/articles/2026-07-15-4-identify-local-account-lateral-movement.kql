// title: 4. Identify local account lateral movement
// date: 2026-07-15
// product: Defender for Endpoint
// tables: DeviceLogonEvents
// purpose: From the article: New Privileged Token Context Telemetry Boosts Advanced Hunting in Microsoft Defender
// source: https://techcommunity.microsoft.com/t5/microsoft-defender-xdr-blog/new-privileged-token-context-telemetry-boosts-advanced-hunting/ba-p/4528613
// kind: article
// author: TalTzhori · Microsoft Defender XDR Blog
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceLogonEvents
| where Timestamp > ago(7d)
| where AdditionalFields has "TokenHasLocalAccountSid"
| where LogonType == "Network" or LogonType == "RemoteInteractive"
