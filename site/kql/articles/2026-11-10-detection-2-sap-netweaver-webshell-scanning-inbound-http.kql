// title: Detection 2: SAP NetWeaver Webshell Scanning - Inbound HTTP Requests to JSP and WAR Paths
// date: 2026-11-10
// product: Sentinel
// tables: CommonSecurityLog
// purpose: From the article: Detection Engineering Brief - Tuesday, November 10, 2026
// source: https://devsecopsdadattack.com/2026-11-10-detection-engineering-brief-tuesday-november-10-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
CommonSecurityLog
| where TimeGenerated >= ago(24h)
| where RequestMethod == "GET"
| where DestinationPort in (80, 443, 8080, 8443, 50000, 50001)
| where RequestURL has_any ("/irj/", "/webdynpro/", "/sap/", "/nwa/", "/bc/", "/servlet/")
    and RequestURL has_any (".jsp", ".war", ".jspx", "shell", "webshell", "cmd", "exec")
| where isnotempty(SourceIP)
| where not(SourceIP startswith "10."
    or SourceIP startswith "192.168."
    or (SourceIP startswith "172." and
        toint(split(SourceIP, ".")[1]) between (16 .. 31)))
| summarize
    RequestCount = count(),
    URLsSeen = make_set(RequestURL),
    Ports = make_set(DestinationPort),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by SourceIP, DeviceProduct, DeviceVendor, bin(TimeGenerated, 1h)
| where RequestCount >= 3
| project
    TimeGenerated,
    SourceIP,
    DeviceProduct,
    DeviceVendor,
    RequestCount,
    URLsSeen,
    Ports,
    FirstSeen,
    LastSeen
| order by RequestCount desc
