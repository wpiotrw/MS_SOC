// title: 3a. Are Graph activity logs flowing at all, and how much of it
// date: 2026-11-12
// product: Entra
// tables: MicrosoftGraphActivityLogs
// purpose: From the article: KQL Detection of the Week: Two Things Called SharePoint
// source: https://devsecopsdadattack.com/2026-11-12-KQL-Detection-of-the-Week-Two-Things-Called-SharePoint/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// 3a. Are Graph activity logs flowing at all, and how much of it
//     comes from apps and carries a linkable token ID?
MicrosoftGraphActivityLogs
| where TimeGenerated >= ago(1d)
| summarize
    TotalRequests            = count(),
    ServicePrincipalRequests = countif(isnotempty(ServicePrincipalId)),
    LinkableRequests         = countif(isnotempty(SignInActivityId)),
    LastObserved             = max(TimeGenerated)
