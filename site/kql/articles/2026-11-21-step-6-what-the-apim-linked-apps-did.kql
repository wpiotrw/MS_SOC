// title: Step 6: what the APIM-linked apps did in Microsoft Graph (MicrosoftGraphActivityLogs)
// date: 2026-11-21
// product: Entra
// tables: MicrosoftGraphActivityLogs
// purpose: Published for the incident: Azure API Management Classic: secrets stored in APIM read through a management-plane flaw (fixed 19 Nov 2026)
// source: https://anderskristiansen.com/post/2026/apim-legacy-access/
// kind: article
// author: Anders Kristiansen
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let recent = 7d;
let ApimAppIds = dynamic([]); // same list as Step 4
MicrosoftGraphActivityLogs
| where TimeGenerated > ago(recent)
| where AppId in (ApimAppIds)
| extend Endpoint = tostring(parse_url(RequestUri).Path)
| summarize Requests = count(),
            Methods = make_set(RequestMethod, 5),
            StatusCodes = make_set(ResponseStatusCode, 10),
            IPs = make_set(IPAddress, 20),
            FirstSeen = min(TimeGenerated)
    by AppId, ServicePrincipalId, Endpoint
| order by Requests desc
