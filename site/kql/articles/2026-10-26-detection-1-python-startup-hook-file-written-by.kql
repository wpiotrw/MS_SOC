// title: Detection 1: Python Startup Hook File Written by pip or Python Process
// date: 2026-10-26
// product: Defender for Endpoint
// tables: DeviceFileEvents
// purpose: From the article: Detection Engineering Brief - Monday, October 26, 2026
// source: https://devsecopsdadattack.com/2026-10-26-detection-engineering-brief-monday-october-26-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceFileEvents
| where ActionType in ("FileCreated", "FileModified")
| where FileName in~ ("sitecustomize.py", "usercustomize.py")
| where FolderPath has_any ("site-packages", "lib/python", "Lib\\site-packages")
| where InitiatingProcessFileName in~ ("pip", "pip3", "pip.exe", "pip3.exe", "python", "python3", "python.exe")
| project
    Timestamp,
    DeviceName,
    FileName,
    FolderPath,
    ActionType,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    InitiatingProcessParentFileName,
    InitiatingProcessAccountName,
    ReportId
