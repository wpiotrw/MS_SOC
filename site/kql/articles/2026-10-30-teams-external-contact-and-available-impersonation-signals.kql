// title: Teams external contact and available impersonation signals
// date: 2026-10-30
// product: Defender for Cloud Apps
// tables: CloudAppEvents
// purpose: From the article: From help desk impersonation to AD CS abuse: Investigating ESC1 and ESC8 intrusion paths
// source: https://www.microsoft.com/en-us/security/blog/2026/10/30/help-desk-impersonation-ad-cs-abuse-investigating-esc1-esc8-intrusion-paths/
// kind: article
// author: Microsoft Security Research, Sagar Patil, Jesse Birch and Tal Tzhori · Microsoft Threat Intelligence
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
CloudAppEvents
| where Timestamp > ago(7d)
| where Application == "Microsoft Teams"
| where
    (ActionType == "ChatCreated" and IsExternalUser == true)
    or ActionType in~ (
        "TeamsImpersonationDetected",
        "SecurityRiskInCallDetected")
| order by Timestamp desc
