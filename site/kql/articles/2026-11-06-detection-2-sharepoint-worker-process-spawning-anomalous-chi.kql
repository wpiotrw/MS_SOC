// title: Detection 2: SharePoint Worker Process Spawning Anomalous Child Processes
// date: 2026-11-06
// product: Defender for Endpoint
// tables: DeviceProcessEvents
// purpose: From the article: Detection Engineering Brief - Friday, November 6, 2026
// source: https://devsecopsdadattack.com/2026-11-06-detection-engineering-brief-friday-november-6-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let suspiciousChildren = dynamic([
    "cmd.exe", "powershell.exe", "pwsh.exe", "wscript.exe", "cscript.exe",
    "mshta.exe", "rundll32.exe", "regsvr32.exe", "certutil.exe", "bitsadmin.exe",
    "net.exe", "net1.exe", "whoami.exe", "nltest.exe", "ipconfig.exe",
    "msiexec.exe", "wmic.exe", "forfiles.exe", "pcalua.exe", "conhost.exe",
    "at.exe", "schtasks.exe", "reg.exe", "curl.exe", "wget.exe"
]);
DeviceProcessEvents
| where TimeGenerated >= ago(14d)
| where InitiatingProcessFileName =~ "w3wp.exe"
| where FileName in~ (suspiciousChildren)
| project
    TimeGenerated,
    DeviceName,
    AccountName,
    AccountDomain,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    InitiatingProcessParentFileName,
    InitiatingProcessId,
    FileName,
    ProcessCommandLine,
    FolderPath,
    SHA256
| order by TimeGenerated desc
