// title: 5. Investigating outbound network connections
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceNetworkEvents
// purpose: From the article: PHP2Shell: Two Critical PHP Vulnerabilities (CVE-2026–109618 and CVE-2026–109619) — Are Your…
// source: https://detect.fyi/php2shell-two-critical-php-vulnerabilities-cve-2026-109618-and-cve-2026-109619-are-your-3f0a0c08f6ec?source=rss----d5fd8f494f6a---4
// kind: article
// author: Sergio Albea · Detect FYI (detection engineering, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let WebProcesses = dynamic([
    "php", "php.exe",
    "php-cgi", "php-cgi.exe",
    "php-fpm",
    "apache2", "httpd",
    "nginx", "w3wp.exe"
]);
DeviceNetworkEvents
| where Timestamp > ago(30d)
| where ActionType == "ConnectionSuccess"
| where RemoteIPType == "Public"
| where InitiatingProcessFileName in~ (WebProcesses)
    or InitiatingProcessFileName startswith "php-fpm"
| summarize
    Connections = count(),
    FirstSeen = min(Timestamp),
    LastSeen = max(Timestamp),
    Ports = make_set(RemotePort, 30),
    URLs = make_set(RemoteUrl, 20)
    by DeviceName,
       InitiatingProcessFileName,
       InitiatingProcessCommandLine,
       RemoteIP
| order by Connections asc
