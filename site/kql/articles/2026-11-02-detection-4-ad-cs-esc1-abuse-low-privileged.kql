// title: Detection 4: AD CS ESC1 Abuse - Low-Privileged Account Certificate Enrollment with Anomalous Template
// date: 2026-11-02
// product: Sentinel
// tables: SecurityEvent
// purpose: From the article: Detection Engineering Brief - Monday, November 2, 2026
// source: https://devsecopsdadattack.com/2026-11-02-detection-engineering-brief-monday-november-2-2026/
// kind: article
// author: DevSecOpsDad · DevSecOpsDad (detection engineering briefs, KQL)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
SecurityEvent
| where TimeGenerated > ago(7d)
| where EventID == 4886
| where SubjectUserName !endswith "$"
| extend RequesterName = tostring(SubjectUserName)
| extend TemplateName = extract(@"Certificate Template:\s*([^\r\n]+)", 1, tostring(EventData))
| where isnotempty(TemplateName)
| summarize
    EnrollmentCount = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by RequesterName, TemplateName, Computer
| order by EnrollmentCount asc
