// Microsoft SOC Brief 20 Nov 2026 - SMS and voice MFA failures after the risk-based CAPTCHA (MC1551151)
// Columns as on the SigninLogs reference cited beside this query. Not run against a tenant in this pass.
SigninLogs
| where TimeGenerated > ago(14d)
| mv-expand Step = todynamic(AuthenticationDetails)
| extend Method = tostring(Step.authenticationMethod), Succeeded = tobool(Step.succeeded), Detail = tostring(Step.authenticationStepResultDetail)
| where Method has_any ("Text message", "Voice call", "Phone call")
| summarize Attempts = count(), Failed = countif(Succeeded == false), Users = dcount(UserPrincipalName),
            Details = make_set(Detail, 10) by Day = bin(TimeGenerated, 1d), IPAddress, Method
| where Failed > 0
| order by Failed desc
