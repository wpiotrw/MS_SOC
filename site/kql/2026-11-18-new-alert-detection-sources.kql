// title: Alert detection sources that appeared in the last 7 days and not in the 30 days before
// date: 2026-11-18
// product: Defender XDR
// tables: AlertInfo
// purpose: Lists ServiceSource and DetectionSource pairs in AlertInfo seen in the last 7 days but not in the 30 days before, with titles and counts, so a new protection that starts raising alerts is noticed on day one. Not run against a tenant in this pass.
// source: https://learn.microsoft.com/en-us/defender-xdr/advanced-hunting-alertinfo-table
// archived by tools/kql_archive.py (CLAUDE.md 5l)
// Microsoft SOC Brief 18 Nov 2026 - detection sources new in the last 7 days
// Columns as on the AlertInfo reference cited beside this query. Not run against a tenant in this pass.
let baseline = AlertInfo
| where Timestamp between (ago(37d) .. ago(7d))
| distinct ServiceSource, DetectionSource;
AlertInfo
| where Timestamp > ago(7d)
| join kind=leftanti baseline on ServiceSource, DetectionSource
| summarize Alerts = count(), Titles = make_set(Title, 15), Severities = make_set(Severity), First = min(Timestamp) by ServiceSource, DetectionSource
| sort by Alerts desc
