// title: Detect Personal OneDrive Sync on corporate endpoints
// date: 2026-10-23
// product: Defender for Endpoint
// tables: DeviceRegistryEvents
// purpose: Detect Personal OneDrive Sync on corporate endpoints
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/DefenderXDR/Detect%20Personal%20OneDrive%20Sync%20on%20corporate%20endpoints.kql
// kind: repo
// author: Steven Lim
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// https://www.microsoft.com/en-us/microsoft-365/roadmap?id=490064

DeviceRegistryEvents 
| where TimeGenerated > ago(1h)
| where ActionType == "RegistryKeyCreated" or ActionType == "RegistryValueSet"
| where RegistryKey has "HKEY_CURRENT_USER\\SOFTWARE\\Microsoft\\OneDrive\\Personal"
