// title: monitoring claude cowork on microsoft 365
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceNetworkEvents, EntraIdSignInEvents
// purpose: monitoring claude cowork on microsoft 365
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/monitoring-claude-cowork-on-microsoft-365.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let LookBack = 30d;
let CoworkDevice =
DeviceNetworkEvents
| where Timestamp > ago(LookBack)
| where ActionType == "ConnectionSuccess"
| where InitiatingProcessFileName has "cowork-svc"
| distinct DeviceName;
EntraIdSignInEvents
| where Timestamp > ago(LookBack)
| where ErrorCode == "0"
| where ApplicationId == "08ad6f98-a4f8-4635-bb8d-f1a3044760f0" 
or ApplicationId == "07c030f6-5743-41b7-ba00-0a6e85f37c17"
| where DeviceName has_any(CoworkDevice)
