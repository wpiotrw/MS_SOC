// title: PHP Worker Process Spawning Shell/Recon Tool
// date: 2026-10-27
// product: Defender for Endpoint
// tables: DeviceProcessEvents
// purpose: [Unvalidated] Identifies a shell or reconnaissance tool spawned directly under a PHP worker process (php-fpm, lsphp, or Apache mod_php, where PHP runs in-process inside the apache2/httpd worker). This is a generic PHP child-process-monitoring indicator, useful against any PHP RCE regardless of root 
// source: https://github.com/Azure/Azure-Sentinel/blob/bfae6cf37d4928d96a9fcc024851bc584f545e3a/Detections/DeviceProcessEvents/phpup2026-PHPShellSpawn.yaml
// kind: repo
// author: Microsoft and contributors
// license: MIT (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceProcessEvents
| where InitiatingProcessFileName matches regex @"(?i)^(php-fpm[\d.]*|php[\d.]*|lsphp[\d]*|apache2|httpd)$"
| where FileName in~ ("sh", "bash", "dash", "zsh", "ash", "python", "python2", "python3",
    "perl", "ruby", "curl", "wget", "nc", "ncat", "nmap", "whoami", "id")
     or ProcessCommandLine has_any (
         "/bin/sh", "/bin/bash", "bash -i", "python -c", "python3 -c",
         "exec(", "eval(", "base64 -d", "curl ", "wget "
       )
| extend HashAlgorithm = "SHA1"
| project TimeGenerated, DeviceName,
          InitiatingProcessAccountName, InitiatingProcessAccountDomain,
          InitiatingProcessAccountSid,
          InitiatingProcessFileName, InitiatingProcessCommandLine,
          FileName, ProcessCommandLine, FolderPath, SHA1, HashAlgorithm
