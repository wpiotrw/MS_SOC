// title: Exposure management browser cookies with credentials of privileged users · Microsoft Defender XDR
// date: 2026-10-21
// product: Defender for Identity
// tables: ExposureGraphEdges, IdentityInfo
// purpose: This hunting query will look in ExposureGraphEdges table for stored credentials, that match users that are privileged.
// source: https://github.com/cyb3rmik3/KQL-threat-hunting-queries/blob/6327d5a78455432e0dbd32cb5c8c281e6f7fda05/01.ThreatHunting/exposure-management-browser-cookies-with-credentials-of-privileged-users.md
// kind: repo
// author: Michalis Michalos
// license: MIT (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let PriveledgedRoles = dynamic(['Global Administrator', 'User Administrator']); // Add Entra ID roles you would like to monitor
ExposureGraphEdges
    | where EdgeLabel has "has credentials of"
    | extend parsedData = parse_json(EdgeProperties)
    | extend browserCookies = parsedData.rawData.browserCookies.browserCookies
    | where browserCookies == "true"
    | project SourceNodeName, SourceNodeLabel, TargetNodeName
| join (IdentityInfo
    | mv-expand AssignedRoles
    | where AssignedRoles has_any(PriveledgedRoles)
    | project AccountName
    )
on $left.TargetNodeName == $right.AccountName
