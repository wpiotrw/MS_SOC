// title: Entra ID Administrative Role (AD Sync)
// date: 2026-10-23
// product: Defender for Identity
// tables: IdentityInfo
// purpose: Entra ID Administrative Role (AD Sync)
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/Sentinel/Entra%20ID%20Administrative%20Role%20(AD-Sync).kql
// kind: repo
