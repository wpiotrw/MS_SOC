// title: Monitor for analytics editing in Microsoft Sentinel
// date: 2026-10-21
// product: 
// tables: 
// purpose: The following query takes into advantage the SentinelAudit table and will allow you to monitor any editing of Analytics rules within Microsoft Sentinel.
// source: https://github.com/cyb3rmik3/KQL-threat-hunting-queries/blob/6327d5a78455432e0dbd32cb5c8c281e6f7fda05/Sentinel/monitor-for-analytics-editing-in-microsoft-sentinel.md
// kind: repo
// author: Michalis Michalos
// license: MIT (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
SentinelAudit
| where Status == @"Success"
| where Description == @"Create or update analytics rule." or Description == @"Analytics rule deleted"
| extend User = parse_json(ExtendedProperties)["CallerName"]
| project TimeGenerated, SentinelResourceName, Description, User
