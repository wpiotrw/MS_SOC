// title: Detect Malicious Impersonation of Deepseek Domains in Email URLs
// date: 2026-10-23
// product: Defender for Office 365
// tables: EmailEvents, EmailUrlInfo
// purpose: Detect Malicious Impersonation of Deepseek Domains in Email URLs
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/DefenderXDR/Detect%20Malicious%20Impersonation%20of%20Deepseek%20Domains%20in%20Email%20URLs.kql
// kind: repo
