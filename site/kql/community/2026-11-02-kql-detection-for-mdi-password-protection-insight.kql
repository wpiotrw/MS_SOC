// title: kql detection for mdi password protection insight
// date: 2026-11-02
// product: Defender XDR
// tables: ExposureGraphEdges, ExposureGraphNodes
// purpose: kql detection for mdi password protection insight
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/kql-detection-for-mdi-password-protection-insight.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
ExposureGraphNodes
| where NodeLabel == "user"
| where parse_json(NodeProperties)["rawData.isActive"] == 'true'
| where parse_json(NodeProperties)["rawData.hasLeakedCredentials"] == 'true' 
or parse_json(NodeProperties)["rawData.hasAdLeakedCredentials"] == 'true'
| join ExposureGraphEdges on $left.NodeId == $right.TargetNodeId
