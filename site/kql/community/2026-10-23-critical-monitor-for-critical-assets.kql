// title: Critical Monitor for Critical Assets
// date: 2026-10-23
// product: Defender XDR
// tables: AlertEvidence, AlertInfo, ExposureGraphNodes
// purpose: Critical Monitor for Critical Assets
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/DefenderXDR/Critical%20Monitor%20for%20Critical%20Assets.kql
// kind: repo
