// title: Direct Send Abuse Detection
// date: 2026-10-23
// product: Defender for Endpoint
// tables: DeviceEvents
// purpose: Direct Send Abuse Detection
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/DefenderXDR/Direct%20Send%20Abuse%20Detection.kql
// kind: repo
// author: Steven Lim
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// https://www.bleepingcomputer.com/news/security/microsoft-365-direct-send-abused-to-send-phishing-as-internal-users/

DeviceEvents
| where Timestamp > ago(1h)
| where ActionType == "DnsQueryResponse"
| extend QueryName = tolower(tostring(parse_json(AdditionalFields)["DnsQueryString"]))
| where QueryName endswith "-com.mail.protection.outlook.com"
