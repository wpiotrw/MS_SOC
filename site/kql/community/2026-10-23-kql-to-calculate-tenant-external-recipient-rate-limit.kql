// title: KQL to calculate Tenant External Recipient Rate Limit
// date: 2026-10-23
// product: Defender for Office 365
// tables: EmailEvents
// purpose: KQL to calculate Tenant External Recipient Rate Limit
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/DefenderXDR/KQL%20to%20calculate%20Tenant%20External%20Recipient%20Rate%20Limit.kql
// kind: repo
// author: Steven Lim
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// Tenant External Recipient Rate Limit or TERR
// https://techcommunity.microsoft.com/blog/exchange/introducing-exchange-online-tenant-outbound-email-limits/4372797

EmailEvents
| where Timestamp > ago(30d)
| where EmailDirection == "Outbound"
| summarize OutboundEmailVol=count() by bin(Timestamp,1d)
| sort by OutboundEmailVol desc
