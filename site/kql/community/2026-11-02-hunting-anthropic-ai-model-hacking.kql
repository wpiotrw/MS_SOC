// title: hunting anthropic ai model hacking
// date: 2026-11-02
// product: Defender for Endpoint
// tables: CloudAppEvents, DeviceNetworkEvents, EmailEvents, EntraIdSignInEvents
// purpose: hunting anthropic ai model hacking
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/hunting-anthropic-ai-model-hacking.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let Lookup = 30d;
let AnthropicEntraSignIn = EntraIdSignInEvents 
| where Timestamp > ago(Lookup)
| where ipv4_is_in_range(IPAddress, "160.79.104.0/21");
let AnthropicInboundTraffic = DeviceNetworkEvents
| where Timestamp > ago(Lookup)
| where ActionType == "InboundConnectionAccepted" and ipv4_is_in_range(RemoteIP, "160.79.104.0/21");
let AnthropicGraphAPIInbound = GraphAPIAuditEvents
| where Timestamp > ago(Lookup)
| where ipv4_is_in_range(IpAddress, "160.79.104.0/21");
let AnthropicM365Inbound = CloudAppEvents
| where Timestamp > ago(Lookup)
| where ipv4_is_in_range(IPAddress, "160.79.104.0/21");
EmailEvents
| where Timestamp > ago(Lookup)
| where ipv4_is_in_range(SenderIPv4, "160.79.104.0/21")
| union AnthropicEntraSignIn, AnthropicInboundTraffic, AnthropicGraphAPIInbound, AnthropicM365Inbound
