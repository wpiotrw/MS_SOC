// title: Last Password Change Time with Account Creation Time
// date: 2026-10-21
// product: Defender for Identity
// tables: IdentityInfo
// purpose: Last Password Change Time with Account Creation Time
// source: https://github.com/jkerai1/KQL-Queries/blob/829b34aea9fce1b50995ff348ee7be6b8eca34f3/Entra/Last%20Password%20Change%20Time%20with%20Account%20Creation%20Time.kql
// kind: repo
// author: Jay Kerai
// license: MIT (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
AADSignInEventsBeta
| join kind=leftouter IdentityInfo on AccountUpn 
//| where Department contains @"Cyber" or JobTitle contains "architect" //Example of further filtering
| summarize arg_max(LastPasswordChangeTimestamp,*) by AccountUpn, CreatedDateTime //Maximize last password change time
| project AccountUpn, CreatedDateTime, LastPasswordChangeTimestamp
