// title: ROSTI (Repackaged Open Source Intelligence) MDE Network Events IOC Hits
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceNetworkEvents
// purpose: ROSTI (Repackaged Open Source Intelligence) MDE Network Events IOC Hits
// source: https://github.com/jkerai1/KQL-Queries/blob/829b34aea9fce1b50995ff348ee7be6b8eca34f3/Defender/ROSTI%20(Repackaged%20Open%20Source%20Intelligence)%20MDE%20Network%20Events%20IOC%20Hits.kql
// kind: repo
// author: Jay Kerai
// license: MIT (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
//Looks for Network Traffic hits from the ROSTI Feed
//Source: https://rosti.bin.re/feeds
let RostiBinIOCs = externaldata(type: string, IndicatorValue: string)[@"https://sduixpgwciwivgpuisyf.supabase.co/storage/v1/object/public/bulk-exports/mde-all.csv"] with (format="csv", ignoreFirstRecord=True);
let DomainList = RostiBinIOCs
| where type == "DomainName" or type == "Url"
| project IndicatorValue;
DeviceNetworkEvents
| where TimeGenerated > ago(90d)
| where RemoteUrl in~(DomainList )
| extend VT_domain = iff(isnotempty(RemoteUrl),strcat(@"https://www.virustotal.com/gui/domain/",RemoteUrl),RemoteUrl)
| summarize count() by RemoteUrl, VT_domain
