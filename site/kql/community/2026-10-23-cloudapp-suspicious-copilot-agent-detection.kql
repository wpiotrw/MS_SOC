// title: CloudApp Suspicious Copilot Agent Detection
// date: 2026-10-23
// product: Defender for Cloud Apps
// tables: CloudAppEvents
// purpose: CloudApp Suspicious Copilot Agent Detection
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/DefenderXDR/CloudApp%20Suspicious%20Copilot%20Agent%20Detection.kql
// kind: repo
