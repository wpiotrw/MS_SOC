// title: detecting the nodejs brotli rce
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceProcessEvents, DeviceTvmSoftwareVulnerabilities
// purpose: detecting the nodejs brotli rce
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/detecting-the-nodejs-brotli-rce.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let NodeJSBrotliRCE =
DeviceTvmSoftwareVulnerabilities 
| where CveId == "CVE-2026-111497"
| distinct DeviceId;
DeviceProcessEvents
| where Timestamp > ago (1h)
| where InitiatingProcessFileName has "node" or InitiatingProcessFileName has "node.exe"
| where FileName in~ ("cmd.exe","powershell.exe","pwsh.exe","conhost.exe","cscript.exe","wscript.exe")
| where DeviceId has_any(NodeJSBrotliRCE)
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine,
InitiatingProcessFileName, InitiatingProcessParentFileName
| order by Timestamp desc
