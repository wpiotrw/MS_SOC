// title: Visualisation of operations that have been seen in the Cloud App logs in the last 30 days · Defender XDR
// date: 2026-10-21
// product: Defender for Cloud Apps
// tables: CloudAppEvents
// purpose: Visualisation of operations that have been seen in the Cloud App logs in the last 30 days · Defender XDR
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/Defender%20For%20Cloud%20Apps/Visualization%20-%20OperationsPerformed.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
CloudAppEvents
| where Timestamp > ago(30d)
| extend Operation = tostring(parse_json(RawEventData).Operation)
| where Operation != "CrmDefaultActivity" //Filter Dynamics 365 activities.
| summarize count() by Operation
| render piechart with(title="Operations last 30 days")
