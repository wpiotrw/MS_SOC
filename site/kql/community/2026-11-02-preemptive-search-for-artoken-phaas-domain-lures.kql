// title: preemptive search for artoken phaas domain lures
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceNetworkEvents
// purpose: preemptive search for artoken phaas domain lures
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/preemptive-search-for-artoken-phaas-domain-lures.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let ARTokenCFIOC=externaldata(Domain:string)
[h'https://raw.githubusercontent.com/SlimKQL/Hunting-Queries-Detection-Rules/refs/heads/main/IOC/ARTokenIOC.csv']
with (format='csv', ignoreFirstRecord=true)
| project Domain;
DeviceNetworkEvents
| where Timestamp > ago(30d)
| where ActionType == "ConnectionSuccess"
| where RemoteUrl has_any(ARTokenCFIOC)
