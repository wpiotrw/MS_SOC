// title: Entra Sign ins to Legacy Azure Active Directory Powershell
// date: 2026-10-21
// product: Entra
// tables: SigninLogs
// purpose: Entra Sign ins to Legacy Azure Active Directory Powershell
// source: https://github.com/jkerai1/KQL-Queries/blob/829b34aea9fce1b50995ff348ee7be6b8eca34f3/Entra/Entra%20Sign-ins%20to%20Legacy%20Azure%20Active%20Directory%20Powershell.kql
// kind: repo
// author: Jay Kerai
// license: MIT (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
SigninLogs
| where TimeGenerated > ago(90d)
| where AppDisplayName == "Azure Active Directory PowerShell"
| summarize count() by UserPrincipalName
