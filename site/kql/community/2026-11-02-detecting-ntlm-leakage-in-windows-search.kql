// title: detecting ntlm leakage in windows search
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceInfo, DeviceNetworkEvents, IdentityInfo, UrlClickEvents
// purpose: detecting ntlm leakage in windows search
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/detecting-ntlm-leakage-in-windows-search.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let LookBack = 1h;
let SearchURI = dynamic(["search:"]);
let SearchURIParameters = dynamic(["query=","crumb="]);
let SearchURIClicker =
UrlClickEvents
| where Timestamp > ago(LookBack)
| where ActionType == @"ClickAllowed"
| where UrlChain has_any(SearchURI) and UrlChain has_any(SearchURIParameters)
| distinct AccountUpn
| join IdentityInfo on AccountUpn
| distinct OnPremSid;
DeviceNetworkEvents
| where Timestamp > ago(LookBack)
| where ActionType == "ConnectionSuccess"
| where RemotePort == 445 and RemoteIPType == "Public"
| join DeviceInfo on DeviceId
| where LoggedOnUsers has_any(SearchURIClicker)
