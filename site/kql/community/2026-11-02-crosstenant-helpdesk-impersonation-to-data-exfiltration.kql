// title: crosstenant helpdesk impersonation to data exfiltration
// date: 2026-11-02
// product: Defender for Cloud Apps
// tables: CloudAppEvents
// purpose: crosstenant helpdesk impersonation to data exfiltration
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/crosstenant-helpdesk-impersonation-to-data-exfiltration.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let HDKeywords = dynamic(["IT", "Support", "Helpdesk", "Desk", "Service", 
"Tech", "Admin", "Ops", "Assist", "Team", "Center"]);
CloudAppEvents
| where Timestamp > ago(1h)
| where Application == "Microsoft Teams"
| where ActionType == "ChatCreated"
| where RawEventData.CommunicationType == "OneOnOne"
| where parse_json(tostring(RawEventData.ParticipantInfo)).HasForeignTenantUsers == true 
| extend AccountUPN = tolower(tostring(parse_json(RawEventData)["UserId"]))
| where AccountUPN endswith ".onmicrosoft.com"
| where AccountUPN has_any(HDKeywords)
