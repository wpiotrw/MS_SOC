// title: mdvm zero day impact analysis
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceTvmSoftwareVulnerabilities
// purpose: mdvm zero day impact analysis
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/mdvm-zero-day-impact-analysis.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceTvmSoftwareVulnerabilities
| mv-expand CveTags
| where CveTags == "Zero day"
| summarize Count=count() by CveId, OSPlatform
| sort by Count desc
