// title: detecting svg payload phishing campaign
// date: 2026-11-02
// product: Defender for Office 365
// tables: EmailAttachmentInfo, EmailEvents
// purpose: detecting svg payload phishing campaign
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/detecting-svg-payload-phishing-campaign.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
EmailAttachmentInfo
| where Timestamp > ago(30d)
| where FileExtension has ".svg" and FileType == "html"
| where FileName matches regex @"[A-Za-z0-9+/=]{20,}"
| join EmailEvents on NetworkMessageId
| where EmailDirection == "Inbound"
| where DeliveryAction == "Delivered" and isempty(EmailAction)
