// title: Hunting query
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceNetworkEvents
// purpose: Hunting query
// source: https://github.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/blob/8008f4eade1b28bef406611896ace73ebec6548d/Microsoft_DefenderXDR/DeviceNetworkEvents/Detect%20WordPress%20plugins%20from%20HTTP%20requests.md
// kind: repo
// author: Sergio Albea
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceNetworkEvents
| where RemoteUrl contains "/wp-content/plugins/"
| extend PluginName = extract(@"/wp-content/plugins/([^/]+)/", 1, RemoteUrl)
| extend Version = extract(@"\?ver=([\d\.]+)$", 1, RemoteUrl)
| extend PluginSiteName = strcat("https://wordpress.org/plugins/", PluginName)
| project PluginSiteName,PluginName,Version, DeviceName, Timestamp,RemoteIPCountry= tostring(geo_info_from_ip_address(RemoteIP).country), ActionType, RemoteUrl
