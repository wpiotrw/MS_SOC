// title: Tracking Proton66 Activity with KQL
// date: 2026-10-23
// product: Defender for Endpoint
// tables: DeviceNetworkEvents
// purpose: Tracking Proton66 Activity with KQL
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/Sentinel/Tracking%20Proton66%20Activity%20with%20KQL.kql
// kind: repo
// author: Steven Lim
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// https://thehackernews.com/2025/04/hackers-abuse-russian-bulletproof-host.html

DeviceNetworkEvents
| where TimeGenerated > ago(90d)
| where ipv4_is_in_any_range(RemoteIP, '45.135.232.0/24', '91.212.166.0/24', '193.143.1.0/24', '45.140.17.0/24', '45.134.26.0/24')
| where ActionType has "ConnectionSuccess" or ActionType has "InboundConnectionAccepted"
| summarize NoOfHits=count() by DeviceName, ActionType, RemoteIP
| sort by NoOfHits desc
