// title: bitwarden cli compromised detection
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceFileEvents
// purpose: bitwarden cli compromised detection
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/bitwarden-cli-compromised-detection.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceFileEvents
| where Timestamp > ago(30d)
| where ActionType == "FileCreated"
| where FileName has "tmp.987654321.lock" and FolderPath has "tmp"
