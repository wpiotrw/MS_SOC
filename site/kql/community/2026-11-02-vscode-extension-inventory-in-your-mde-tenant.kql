// title: vscode extension inventory in your mde tenant
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceProcessEvents
// purpose: vscode extension inventory in your mde tenant
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/vscode-extension-inventory-in-your-mde-tenant.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceProcessEvents
| where Timestamp > ago(30d)
| where InitiatingProcessCommandLine has "\\.vscode\\extensions\\" and InitiatingProcessCommandLine has "code.exe"
| extend ExtensionName = extract(@"extensions\\([^\\]+)", 1, InitiatingProcessCommandLine)
| distinct DeviceName, ExtensionName
| sort by DeviceName asc
