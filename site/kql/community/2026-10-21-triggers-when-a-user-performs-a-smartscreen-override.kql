// title: Triggers when a user performs a SmartScreen Override action · Defender XDR
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceEvents
// purpose: This query lists all SmartScreen override related events.
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/Defender%20For%20Endpoint/SmartScreen/SmartScreenOverride.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceEvents
| where ingestion_time() > ago(7d)
| where ActionType == "SmartScreenUserOverride"
