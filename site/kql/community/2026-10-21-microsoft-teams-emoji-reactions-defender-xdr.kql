// title: Microsoft Teams Emoji Reactions · Defender XDR
// date: 2026-10-21
// product: Defender for Cloud Apps
// tables: CloudAppEvents
// purpose: This query lists the statistics of the Emoji reactions that have been send via Microsoft Teams
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/Fun/TeamsEmojiReactions.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
CloudAppEvents
| where Application == "Microsoft Teams"
| where ActionType == "ReactedToMessage"
| extend Emoji = tostring(RawEventData.MessageReactionType)
| where isnotempty(Emoji)
| summarize TotalUsage = count() by Emoji
| sort by TotalUsage
