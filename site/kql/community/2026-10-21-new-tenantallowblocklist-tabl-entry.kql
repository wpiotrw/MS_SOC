// title: New TenantAllowBlockList (TABL) entry
// date: 2026-10-21
// product: Defender for Cloud Apps
// tables: CloudAppEvents
// purpose: New TenantAllowBlockList (TABL) entry
// source: https://github.com/jkerai1/KQL-Queries/blob/829b34aea9fce1b50995ff348ee7be6b8eca34f3/Office%20365/New%20TenantAllowBlockList%20(TABL)%20entry.kql
// kind: repo
