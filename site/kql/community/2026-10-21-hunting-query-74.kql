// title: Hunting query
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceTvmSoftwareVulnerabilities, DeviceTvmSoftwareVulnerabilitiesKB
// purpose: Hunting query
// source: https://github.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/blob/8008f4eade1b28bef406611896ace73ebec6548d/Microsoft_DefenderXDR/DeviceTvmSoftwareVulnerabilities/Enriching%20CVE%20Tables%20with%20CVE%20Mitre%20Data.md
// kind: repo
// author: Sergio Albea
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// You can use this line to search for specific CVE ID
let CVEQuery = "CVE-2024-27848";
let CVE = externaldata(CVEData: string)
    [@"https://cve.mitre.org/data/downloads/allitems.csv"] with (format="txt");
CVE
| where CVEData !startswith '"' and CVEData !startswith ","
| extend
    Name = split(CVEData, ',')[0],
    Status = split(CVEData, ',')[1],
    Description = split(CVEData, ',')[2],
    AdditionalInfo0 = split(CVEData, '"')[3]
| extend
    AdditionalInfo1 = split(AdditionalInfo0, '|')[0],
    AdditionalInfo2 = split(AdditionalInfo0, '|')[1],
    AdditionalInfo3 = split(AdditionalInfo0, '|')[2]
| extend Description = substring(Description, 1)
| extend Name = tostring(Name)
| sort by Name
| where Name in (CVEQuery)
| join kind=inner (
    DeviceTvmSoftwareVulnerabilities)
    on $left.Name == $right.CveId
| join DeviceTvmSoftwareVulnerabilitiesKB on $left.CveId == $right.CveId
| project
    Name,
    DeviceName,
    CvssScore,
    IsExploitAvailable,
    SoftwareName,
    Status,
    Description,
    AdditionalInfo0,
    AdditionalInfo1,
    AdditionalInfo2,
    AdditionalInfo3
