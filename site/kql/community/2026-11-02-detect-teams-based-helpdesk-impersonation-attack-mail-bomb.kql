// title: detect teams based helpdesk impersonation attack mail bomb follow by social engineering attack
// date: 2026-11-02
// product: Defender for Office 365
// tables: CloudAppEvents, EmailEvents
// purpose: detect teams based helpdesk impersonation attack mail bomb follow by social engineering attack
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/detect-teams-based-helpdesk-impersonation-attack-mail-bomb-follow-by-social-engineering-attack.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let Lookup = 1h;
let MailBombVictim =
EmailEvents
| where Timestamp > ago(Lookup)
| where DetectionMethods has "Mail bombing"
| distinct RecipientEmailAddress;
CloudAppEvents
| where Timestamp > ago(Lookup)
| where ActionType == "TeamsImpersonationDetected"
| extend ImpersonationDisplayName = tostring(parse_json(tostring(RawEventData.Sender)).DisplayName)
| extend ImpersonationUPN = tostring(parse_json(tostring(RawEventData.Sender)).UPN)
| extend ImpactedUserUPN = tostring(RawEventData.UserId)
| where ImpactedUserUPN has_any(MailBombVictim)
| project Timestamp, AccountType, ImpactedUserUPN, ImpersonationDisplayName, ImpersonationUPN
