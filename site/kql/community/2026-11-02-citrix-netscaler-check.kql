// title: citrix netscaler check
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceInfo
// purpose: citrix netscaler check
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/citrix-netscaler-check.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceInfo
| where Timestamp > ago(30d)
| where Vendor == "Citrix" and OSDistribution == "NetScaler"
| summarize arg_max(Timestamp, *) by DeviceId
