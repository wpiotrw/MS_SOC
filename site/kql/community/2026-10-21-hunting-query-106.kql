// title: Hunting query
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceEvents
// purpose: Hunting query
// source: https://github.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/blob/8008f4eade1b28bef406611896ace73ebec6548d/KQL-Collectors/IP_KQL_Collectors/FH02%20-%20File%20with%20Malware.md
// kind: repo
// author: Sergio Albea
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
{
  "Query": " DeviceEvents | where Timestamp > ago(1d) | where ActionType == 'AntivirusDetection' | extend parsed = parse_json(AdditionalFields) | extend ThreatName = tostring(parsed.ThreatName) , ResourceSchema = tostring(parsed.ResourceSchema) | extend Time_ = format_datetime(Timestamp, 'dd-MM-yyyy') | where ThreatName in ('Trojan:Win32/InfoStealer!MSR','PUADlManager:Win32/DownloadSponsor','Backdoor:PHP/Chopper.B!dha','EUS:Win32/CustomEnterpriseBlock','Worm:Win32/Netsky.P@mm','PUABundler:Win32/FileZilla_BundleInstaller') | distinct Time_,ActionType, FileName, SHA1,SHA256, FileOriginIP, FileOriginUrl,ThreatName,MD5 | extend rawHash = substring(tostring(hash_sha256(strcat(1, tostring(rand())))), 0, 32) | extend GeneratedUUID= strcat( substring(rawHash, 0, 8), '-', substring(rawHash, 8, 4), '-', substring(rawHash, 12, 4), '-', substring(rawHash, 16, 4), '-', substring(rawHash, 20, 12) ) | distinct Time_,ActionType, FileName, SHA1,SHA256, FileOriginIP, FileOriginUrl,ThreatName, GeneratedUUID,MD5 "
}
