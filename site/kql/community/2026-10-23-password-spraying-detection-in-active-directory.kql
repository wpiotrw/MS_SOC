// Event ID 4625
// Mitre ATT&CK T1110

Anomalies
| where TimeGenerated > ago(1d)
| where RuleName == "Attempted user account bruteforce per logon type"
or RuleName == "Attempted user account bruteforce"
| where Score > 0.5
