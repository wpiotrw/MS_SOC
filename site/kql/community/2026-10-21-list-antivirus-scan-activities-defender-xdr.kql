// title: List Antivirus Scan Activities · Defender XDR
// date: 2026-10-21
// product: Defender for Cloud Apps
// tables: CloudAppEvents
// purpose: This query lists all manual (and playbook related) anvitius actions that are initiated and the related comments per device.
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/Defender%20XDR/ManualAntivirusScans.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
CloudAppEvents
| where ActionType == "RunAntiVirusScan"
| extend DeviceName = tostring(parse_json(RawEventData).DeviceName), ActionComment = tostring(parse_json(RawEventData).ActionComment), ActionScope = tostring(parse_json(RawEventData).ActionScope)
| summarize TotalAntivirusScans = count(), ScanTypes = make_set(ActionScope), Comments = make_set(ActionComment) by DeviceName
