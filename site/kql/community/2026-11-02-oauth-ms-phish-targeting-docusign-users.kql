// title: oauth ms phish targeting docusign users
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceNetworkEvents, EmailUrlInfo
// purpose: oauth ms phish targeting docusign users
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/oauth-ms-phish-targeting-docusign-users.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let Lookback = 1h;
let OauthMSPhish =
EmailUrlInfo
| where Timestamp > ago(Lookback)
| where Url matches regex @"page-docusign-[a-z0-9]+\.workers\.dev";
DeviceNetworkEvents
| where Timestamp > ago(Lookback)
| where RemoteUrl matches regex @"page-docusign-[a-z0-9]+\.workers\.dev"
| union OauthMSPhish
