// title: AMSI Script Detection · Sentinel
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceEvents
// purpose: The Windows Antimalware Scan Interface (AMSI) is a versatile interface standard that allows your applications and services to integrate with any antimalware product that's present on a machine. AMSI provides enhanced malware protection for your end-users and their data, applications, and workloads. 
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/Defender%20For%20Endpoint/AMSIScriptDetections.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceEvents 
| where ActionType == "AmsiScriptDetection" 
| extend Description = tostring(parse_json(AdditionalFields).Description) 
| project TimeGenerated, DeviceName, DeviceId, InitiatingProcessCommandLine, Description, ReportId
