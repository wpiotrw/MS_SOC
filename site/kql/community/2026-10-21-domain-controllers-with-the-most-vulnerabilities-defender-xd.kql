// title: Domain Controllers with the most vulnerabilities · Defender XDR
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceEvents, DeviceNetworkEvents, DeviceTvmSoftwareVulnerabilities
// purpose: Domain Controllers with the most vulnerabilities · Defender XDR
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/Vulnerability%20Management/DomainControllersWithTheMostVulnerabilities.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let AllDomainControllers =
     DeviceNetworkEvents
     | where LocalPort == 88
     | where LocalIPType == "FourToSixMapping"
     | summarize make_set(DeviceId);
DeviceTvmSoftwareVulnerabilities
| where DeviceId has_any (AllDomainControllers)
| summarize TotalVulnerabilities = count(), VulnerabeCVE = make_set(CveId) by DeviceName
| sort by TotalVulnerabilities
// Join with random event to get the required fields if you want to detect on this behaviour, the DeviceTvmSoftwareVulnerabilities does not contain the needed events. Ignore the process tree and only look at the raw events.
//  join kind=inner (DeviceEvents
//| where Timestamp > ago(30d)
//| summarize arg_max(Timestamp, *) by DeviceId
//| project DeviceId, Timestamp, ReportId) on DeviceId
