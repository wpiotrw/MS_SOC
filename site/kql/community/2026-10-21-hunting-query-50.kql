// title: Hunting query
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceFileEvents
// purpose: Hunting query
// source: https://github.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/blob/8008f4eade1b28bef406611896ace73ebec6548d/Microsoft_DefenderXDR/DeviceFileEvents/Detect%20Shebang%20code%20inside%20Device%20Files.md
// kind: repo
// author: Sergio Albea
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceFileEvents 
| extend AF=parse_json(AdditionalFields) | where tostring(AF.FileType) == "Shebang" 
| where FolderPath has_any ("\\Downloads\\", "\\AppData\\Local\\Temp\\", "/tmp/", "/var/tmp/", "/Users/Shared/", "/Downloads/")
 | project Timestamp, DeviceName,DeviceId, ActionType, FileName, FolderPath, SHA256, InitiatingProcessFileName, 
InitiatingProcessCommandLine,ReportId
