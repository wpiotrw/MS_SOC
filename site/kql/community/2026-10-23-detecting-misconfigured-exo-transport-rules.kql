// title: Detecting Misconfigured EXO Transport Rules
// date: 2026-10-23
// product: Defender for Office 365
// tables: EmailEvents
// purpose: Detecting Misconfigured EXO Transport Rules
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/DefenderXDR/Detecting%20Misconfigured%20EXO%20Transport%20Rules.kql
// kind: repo
// author: Steven Lim
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// Detecting Misconfigured EXO Transport Rules

EmailEvents
| where EmailDirection == "Inbound"
| where isnotempty(ThreatClassification)
| where LatestDeliveryAction == "Delivered"
| where DeliveryLocation != "Junk folder"
| summarize Count=count() by tostring(parse_json(AdditionalFields)["TransportRuleGuid"])
