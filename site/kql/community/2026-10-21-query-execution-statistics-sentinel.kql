// title: Query Execution Statistics · Sentinel
// date: 2026-10-21
// product: Sentinel
// tables: LAQueryLogs
// purpose: List the query execution statistics for your Log Analytics Workspace, this returns the *UnqiueQueryCount* and the *TotalQueriesExecuted* for each Azure Active Directory User. To audit the query executions the Azure Diagnostics settings for the Log Analytics Workspace need to be set, see references o
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/Log%20Analytics/LogAnalyticsQueryStatistics.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
LAQueryLogs
| summarize UnqiueQueryCount = dcount(QueryText), TotalQueriesExecuted = count() by AADEmail
| sort by AADEmail
