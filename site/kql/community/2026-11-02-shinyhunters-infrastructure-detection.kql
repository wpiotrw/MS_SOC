// title: shinyhunters infrastructure detection
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceNetworkEvents, EmailUrlInfo
// purpose: shinyhunters infrastructure detection
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/shinyhunters-infrastructure-detection.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let ShinyHuntersInfra = dynamic([".acess-terms.com",".okta.guide",".sso.guide",
".okta.domains",".setup-okta.com",".help-okta.com",".desk-okta.com",".safe-okta.com",
".prod-okta.com",".lock-okta.com",".passkeysetup.com"]);
let EmailUrlThreat =
EmailUrlInfo
| where Timestamp > ago(1h)
| where Url has_any(ShinyHuntersInfra);
DeviceNetworkEvents
| where Timestamp > ago(1h)
| where RemoteUrl has_any(ShinyHuntersInfra)
| union EmailUrlThreat
