// title: a 360 surveillance kql for monitoring potential risks from entra and mde endpoint activities amid the usisraeliran escalation
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceNetworkEvents, EntraIdSignInEvents
// purpose: a 360 surveillance kql for monitoring potential risks from entra and mde endpoint activities amid the usisraeliran escalation
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/a-360-surveillance-kql-for-monitoring-potential-risks-from-entra-and-mde-endpoint-activities-amid-the-usisraeliran-escalation.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let CT = dynamic(["InboundConnectionAccepted","ConnectionAcknowledged",
"ConnectionAttempt","ConnectionFailed","ConnectionSuccess","ConnectionRequest"]);
let EndpointConnection =
DeviceNetworkEvents
| where Timestamp > ago(7d)
| where ActionType has_any(CT)
| extend GeoLo = geo_info_from_ip_address(RemoteIP)
| where GeoLo has "Iran";
EntraIdSignInEvents
| where Timestamp > ago(7d)
| where Country == "IR"
| union EndpointConnection

| summarize Count=count() by bin(Timestamp,1h)
