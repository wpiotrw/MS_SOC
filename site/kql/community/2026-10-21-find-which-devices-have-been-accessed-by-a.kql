// title: Find which devices have been accessed by a list of compromised accounts and which protocol was used to connect · Sentinel
// date: 2026-10-21
// product: Defender for Identity
// tables: IdentityLogonEvents
// purpose: Find which devices have been accessed by a list of compromised accounts and which protocol was used to connect · Sentinel
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/DFIR/MDI%20-%20Lateral-Movement-By-Compromised-Accounts.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let ComprimsedUsers = dynamic(['user1', 'user2']);
let SearchWindow = 48h; //Customizable h = hours, d = days
IdentityLogonEvents
| where TimeGenerated > (now() - SearchWindow)
| where AccountName has_any (ComprimsedUsers)
| where isnotempty(TargetDeviceName)
| where ActionType == "LogonSuccess"
| project TimeGenerated, AccountName, Protocol, TargetDeviceName
