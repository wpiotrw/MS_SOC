// title: Assignment of Local Administrator Entra Role
// date: 2026-10-21
// product: Entra
// tables: AuditLogs
// purpose: Assignment of Local Administrator Entra Role
// source: https://github.com/jkerai1/KQL-Queries/blob/829b34aea9fce1b50995ff348ee7be6b8eca34f3/Entra/Assignment%20of%20Local%20Administrator%20Entra%20Role.kql
