// title: NTLMv2 Hash Leak via COM Detection
// date: 2026-10-23
// product: Defender for Endpoint
// tables: DeviceLogonEvents, DeviceNetworkEvents
// purpose: NTLMv2 Hash Leak via COM Detection
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/DefenderXDR/NTLMv2%20Hash%20Leak%20via%20COM%20Detection.kql
// kind: repo
// author: Steven Lim
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// NTLMv2 Hash Leak via COM Detection
// https://medium.com/@andreabocchetti88/ntlmv2-hash-leak-via-com-auto-execution-543919e577cb

let QueryPeriod = 1h;
let UserDeviceLogon =
DeviceLogonEvents 
| where Timestamp > ago(QueryPeriod)
| where ActionType == "LogonSuccess" and LogonType == "Interactive"
| where parse_json(AdditionalFields)["IsLocalLogon"] == 'true'
| distinct DeviceName;
DeviceNetworkEvents
| where Timestamp > ago(QueryPeriod)
| where RemotePort == "445" and RemoteIPType == "Public"
| where ActionType == "ConnectionSuccess"
| where DeviceName has_any (UserDeviceLogon)
