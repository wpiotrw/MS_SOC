// title: Visualization authentication Methods Used · Sentinel
// date: 2026-10-21
// product: Entra
// tables: SigninLogs
// purpose: This visualisation shows the authentication methods that have been used based on the selected TimeFrame.
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/Azure%20Active%20Directory/Visualization%20-%20AuthenticationMethodsUsed.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let TimeFrame = 30d;
SigninLogs
| where TimeGenerated > ago(TimeFrame)
| where ResultType == 0
| summarize Total = count() by AuthenticationProtocol, bin(TimeGenerated, 1d)
