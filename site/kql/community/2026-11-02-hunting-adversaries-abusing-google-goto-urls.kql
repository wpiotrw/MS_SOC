// title: hunting adversaries abusing google goto urls
// date: 2026-11-02
// product: Defender for Office 365
// tables: EmailEvents, EmailUrlInfo
// purpose: hunting adversaries abusing google goto urls
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/hunting-adversaries-abusing-google-goto-urls.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let LookupPeriod = 7d;
EmailUrlInfo
| where TimeGenerated > ago(LookupPeriod)
| where Url has "www.google.com/goto?url="
| join EmailEvents on NetworkMessageId
| where EmailDirection == "Inbound" and DeliveryAction == "Delivered"
| where IsFirstContact == true
| summarize GoogleGotoUrlCount=count() by SenderFromDomain
| sort by GoogleGotoUrlCount desc
