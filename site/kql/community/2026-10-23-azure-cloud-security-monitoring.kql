// tables: AzureActivity, CloudAppEvents, CloudAuditEvents, ExposureGraphEdges, ExposureGraphNodes, ThreatIntelligenceIndicator
// purpose: Azure Cloud Security Monitoring
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/Azure/Azure%20Cloud%20Security%20Monitoring.kql
