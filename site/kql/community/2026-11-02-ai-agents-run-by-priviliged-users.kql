// title: ai agents run by priviliged users
// date: 2026-11-02
// product: Defender for Identity
// tables: AgentsInfo, IdentityInfo
// purpose: ai agents run by priviliged users
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/ai-agents-run-by-priviliged-users.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let PrivilgedUsers =
IdentityInfo
| where Timestamp > ago(30d) 
| where isnotempty(tostring(PrivilegedEntraPimRoles))
| distinct AccountUpn;
AgentsInfo 
| where Platform == @"LocalAgents"
| summarize arg_max(Timestamp, *) by AgentId
| extend AgentData = parse_json(RawAgentInfo)
| extend AgentOwner = tostring(AgentData.localAgentMetadata.upn)
| where AgentOwner has_any(PrivilgedUsers)
| where LifecycleStatus != @"Deleted"
