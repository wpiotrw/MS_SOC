// title: Hunting query
// date: 2026-10-21
// product: Defender for Office 365
// tables: EmailAttachmentInfo, EmailEvents
// purpose: Hunting query
// source: https://github.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/blob/8008f4eade1b28bef406611896ace73ebec6548d/KQL-Collectors/IP_KQL_Collectors/FH01%20-%20Email%20Malware.md
// kind: repo
// author: Sergio Albea
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
{
  "Query": "  EmailEvents  | where Timestamp > ago(1d) | where ThreatTypes has 'Malware' | join kind=inner (EmailAttachmentInfo) on $left.NetworkMessageId == $right.NetworkMessageId | where SenderFromAddress == SenderFromAddress1 | where FileType !in ('png','jpeg','jpg') | extend geo_ip = iff(isnotempty(SenderIPv4),geo_info_from_ip_address(SenderIPv4).country,geo_info_from_ip_address(SenderIPv6).country) | where  isnotempty(geo_ip) | extend  Time_ =  format_datetime( Timestamp, 'dd-MM-yyyy') |  project    Time_,SenderFromAddress, SenderDisplayName, SenderFromDomain,SenderIP=iff(isnotempty(SenderIPv4),SenderIPv4,SenderIPv6), geo_ip, FileName, FileType,ThreatNames,SHA256,Subject,MD5=hash_md5(SHA256)  | extend rawHash = substring(tostring(hash_sha256(strcat(1, tostring(rand())))), 0, 32) | extend GeneratedUUID= strcat( substring(rawHash, 0, 8), '-', substring(rawHash, 8, 4), '-', substring(rawHash, 12, 4), '-', substring(rawHash, 16, 4), '-', substring(rawHash, 20, 12) )  | project-away rawHash "
}
