// title: Tracking The Most Dangerous Entra Admin Role
// date: 2026-10-23
// product: Defender for Identity
// tables: ExposureGraphNodes, IdentityLogonEvents
// purpose: Tracking The Most Dangerous Entra Admin Role
// source: https://github.com/SlimKQL/Hunting-Queries-Detection-Rules/blob/9c838dc165ac602c525321c6f475e5c90f2fd7d2/DefenderXDR/Tracking%20The%20Most%20Dangerous%20Entra%20Admin%20Role.kql
// kind: repo
