// title:  · MITRE ATT&CK Technique(s)
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceNetworkEvents
// purpose:  · MITRE ATT&CK Technique(s)
// source: https://github.com/Sergio-Albea-Git/Threat-Hunting-KQL-Queries/blob/8008f4eade1b28bef406611896ace73ebec6548d/Microsoft_DefenderXDR/DeviceNetworkEvents/Monitoring%20Explorer-Initiated%20External%20Traffic.md
// kind: repo
// author: Sergio Albea
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
//Sergio Albea
DeviceNetworkEvents
| where Timestamp >= ago(1d)
| where InitiatingProcessFileName =~ "explorer.exe"
| where RemoteIPType == "Public"
| where not(RemoteUrl has_any (dynamic(['bing.com','assets.msn.com']))) 
| extend geo_ip = tostring(geo_info_from_ip_address(RemoteIP).country)
//| where geo_ip !in ('','')
| summarize Connections=count(),make_set(RemoteUrl),make_set(RemoteIP) by DeviceName,DeviceId,InitiatingProcessFileName, geo_ip, Timestamp, ReportId
