// title: hunting teams vishing with defenderxdr
// date: 2026-11-02
// product: Defender for Cloud Apps
// tables: CloudAppEvents
// purpose: hunting teams vishing with defenderxdr
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/hunting-teams-vishing-with-defenderxdr.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
CloudAppEvents
| where Timestamp > ago(1h)
| where ActionType == "SecurityRiskInCallDetected"
| extend CallId = tostring(RawEventData.CallId)
| join CallActivityEvents on CallId
