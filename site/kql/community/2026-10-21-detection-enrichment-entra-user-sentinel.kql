// title: Detection Enrichment - Entra User · Sentinel
// date: 2026-10-21
// product: 
// tables: 
// purpose: Sentinel Data Lake job to put an aggregated table of entra users in LAW for filtering/enrichment in detections and automations.
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/Data%20Lake/Jobs/Detection%20Enrichment%20-%20Entra%20User.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
EntraUsers
| where TimeGenerated > ago(3d)
| summarize arg_max(TimeGenerated, * ) by id
| project-away _*
| project-rename ObjectId = id
