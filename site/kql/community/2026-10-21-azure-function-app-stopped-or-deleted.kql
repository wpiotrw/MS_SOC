// title: Azure Function App Stopped or Deleted
// date: 2026-10-21
// product: Sentinel
// tables: AzureActivity
// purpose: Azure Function App Stopped or Deleted
// source: https://github.com/jkerai1/KQL-Queries/blob/829b34aea9fce1b50995ff348ee7be6b8eca34f3/Azure/Azure%20Function%20App%20Stopped%20or%20Deleted.kql
// kind: repo
// author: Jay Kerai
// license: MIT (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
AzureActivity
| where OperationNameValue == "StopWebSite" or OperationName == "DeleteWebSite" or OperationNameValue == "MICROSOFT.WEB/SITES/DELETE"
| where ActivityStatusValue startswith "Succe" or ActivityStatusValue startswith "accept" 
//Azure Activity must be enabled https://learn.microsoft.com/en-us/azure/azure-monitor/platform/activity-log?tabs=log-analytics?WT.mc_id=MVP_473477
