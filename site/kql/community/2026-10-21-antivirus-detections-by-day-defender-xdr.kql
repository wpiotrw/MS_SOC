// title: Antivirus Detections by day · Defender XDR
// date: 2026-10-21
// product: Defender for Endpoint
// tables: DeviceEvents
// purpose: This query visualizes the daily antivirus detections, which can give an indication in anomalous amount of activities that are performed in your environment.
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/Security%20Operations/Visualization%20-%20AntivirusEventsByDay.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
DeviceEvents
| where Timestamp > ago(30d)
| where ActionType == 'AntivirusDetection'
| summarize count() by bin(Timestamp, 1d)
| render linechart with(title="Antivirus Detections by Day")
