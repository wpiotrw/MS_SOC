// title: hunting nanoclaw
// date: 2026-11-02
// product: Defender for Endpoint
// tables: DeviceProcessEvents
// purpose: hunting nanoclaw
// source: https://github.com/SlimKQL/Detections.AI/blob/e9aedb2826722ccf078f2d099a8f5faac74f704d/KQL/hunting-nanoclaw.kql
// kind: repo
// author: Steven Lim
// license: not stated (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let Lookback = 7d;
let InstallCmd = "https://github.com/qwibitai/nanoclaw";
let ClaudeEP =
DeviceProcessEvents
| where Timestamp > ago(Lookback)
| where (FileName has "node" or FileName has "node.exe") and 
(InitiatingProcessCommandLine has "claude" or ProcessCommandLine has "claude")
| distinct DeviceName;
DeviceProcessEvents
| where Timestamp > ago(Lookback)
| where InitiatingProcessCommandLine has InstallCmd or ProcessCommandLine has InstallCmd
| where InitiatingProcessCommandLine has "git" or ProcessCommandLine has "git"
| where InitiatingProcessCommandLine has "clone" or ProcessCommandLine has "clone"
| where DeviceName has_any(ClaudeEP)
