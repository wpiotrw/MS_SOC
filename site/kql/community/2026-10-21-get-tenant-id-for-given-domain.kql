// title: Get Tenant ID for Given Domain
// date: 2026-10-21
// product: 
// tables: 
// purpose: Get Tenant ID for Given Domain
// source: https://github.com/jkerai1/KQL-Queries/blob/829b34aea9fce1b50995ff348ee7be6b8eca34f3/Entra/Get%20Tenant%20ID%20for%20Given%20Domain.kql
// kind: repo
