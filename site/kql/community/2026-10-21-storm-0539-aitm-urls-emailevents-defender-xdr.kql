// title: Storm-0539 AiTM URLs - EmailEvents · Defender XDR
// date: 2026-10-21
// product: Defender for Office 365
// tables: EmailEvents, EmailUrlInfo
// purpose: Microsoft Threat Intelligence has identified that the following url parts are used by Storm-0539 to deploy AiTM phishing pages: - /Udlaps/ - /Usrlop/ - /adls/index.html - /saml2/index.html This query lists matches on the parts of the URL if found in emails.
// source: https://github.com/Bert-JanP/Hunting-Queries-Detection-Rules/blob/65d11700e1cb878403d87312acdd6b9a8dd622c1/Threat%20Hunting/STORM-0539%20URLPathsEmail.md
// kind: repo
// author: Bert-Jan Pals
// license: BSD-3-Clause (as stated by the repository)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
let URLs = dynamic([@'/Udlaps/', @'/Usrlop/', @'/adls/index.html', @'/saml2/index.html']);
EmailUrlInfo
| where Url has_any (URLs)
| join kind=inner EmailEvents on NetworkMessageId
