// title: Service-principal sign-ins from the reported IP or scripted user agents
// date: 2026-10-19
// product: Entra
// tables: AADServicePrincipalSignInLogs
// purpose: Threat Research: ConnectWise Cloud Backup (SkyKick): a vendor's multi-tenant app credential used to enter Microsoft 365 tenants
// source: https://www.huntress.com/blog/vendor-credential-enables-unauthorized-access
// kind: incident-note
// author: Threat Research analysis (a person)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
AADServicePrincipalSignInLogs
| where TimeGenerated > datetime(2026-10-13)
| where IPAddress == "144.172.64.128"
    or ServicePrincipalName has_any ("ConnectWise", "SkyKick", "Cloud Management")
| summarize SignIns = count(), IPs = make_set(IPAddress, 20), First = min(TimeGenerated), Last = max(TimeGenerated)
    by ServicePrincipalName, AppId, ResultType
