// title: Quick Assist started after a Teams contact from an external tenant (Defender XDR)
// date: 2026-11-25
// product: Defender for Endpoint
// tables: DeviceProcessEvents
// purpose: Threat Research: Teams help-desk impersonation leading to AD CS abuse (ESC1 and ESC8), DCSync and Rclone exfiltration
// source: https://www.microsoft.com/en-us/security/blog/2026/10/30/help-desk-impersonation-ad-cs-abuse-investigating-esc1-esc8-intrusion-paths/
// kind: incident-note
// author: Threat Research analysis (the morning analysis)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// Teams help-desk impersonation to AD CS abuse - Quick Assist sessions and runtimes staged in KB folders
// Defender XDR advanced hunting; Defender for Endpoint DeviceProcessEvents
DeviceProcessEvents
| where Timestamp > ago(30d)
| where FileName =~ "QuickAssist.exe"
   or (FolderPath has @"\AppData\" and FolderPath matches regex @"\\KB[0-9]+" and FileName in~ ("python.exe", "pythonw.exe", "java.exe", "javaw.exe", "bun.exe"))
| project Timestamp, DeviceName, AccountName, FileName, FolderPath, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp desc
