// title: After rotation: an old client secret of an APIM-linked app still signing in (AADServicePrincipalSignInLogs)
// date: 2026-11-24
// product: Entra
// tables: AADServicePrincipalSignInLogs
// purpose: Threat Research: Azure API Management Classic: secrets stored in APIM read through a management-plane flaw (fixed 19 Nov 2026)
// source: https://www.bleepingcomputer.com/news/security/microsoft-azure-flaw-exploited-to-steal-customers-api-credentials/
// kind: incident-note
// author: Threat Research analysis (the morning analysis)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// APIM Classic secrets (Nov 2026): the secret you rotated must stop being used - any later attempt with its key ID is the attacker or a forgotten system
let ApimAppIds = dynamic([]);            // apps whose client secrets were stored in APIM (identity providers, OpenID Connect, named values)
let RotatedAt = datetime(2026-11-24);    // when you rotated them
let OldKeys = AADServicePrincipalSignInLogs
    | where TimeGenerated between (ago(30d) .. RotatedAt)
    | where AppId in (ApimAppIds) and isnotempty(ServicePrincipalCredentialKeyId)
    | distinct AppId, ServicePrincipalCredentialKeyId;
AADServicePrincipalSignInLogs
| where TimeGenerated > RotatedAt
| where AppId in (ApimAppIds)
| join kind=inner OldKeys on AppId, ServicePrincipalCredentialKeyId
| summarize Attempts = count(), Successes = countif(ResultType == "0"), IPs = make_set(IPAddress, 20),
            Resources = make_set(ResourceDisplayName, 10), Last = max(TimeGenerated)
    by AppId, ServicePrincipalName, ServicePrincipalCredentialKeyId
| order by Successes desc
