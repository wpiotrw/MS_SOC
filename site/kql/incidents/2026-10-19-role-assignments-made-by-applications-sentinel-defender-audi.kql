// title: Role assignments made by applications (Sentinel / Defender: AuditLogs)
// date: 2026-10-19
// product: Entra
// tables: AuditLogs
// purpose: Threat Research: ConnectWise Cloud Backup (SkyKick): a vendor's multi-tenant app credential used to enter Microsoft 365 tenants
// source: https://www.huntress.com/blog/vendor-credential-enables-unauthorized-access
// kind: incident-note
// author: Threat Research analysis (a person)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
AuditLogs
| where TimeGenerated > datetime(2026-10-13)
| where OperationName == "Add member to role"
| where isnotempty(tostring(InitiatedBy.app.servicePrincipalId))
| extend Actor = tostring(InitiatedBy.app.displayName),
         Role = tostring(TargetResources[0].modifiedProperties[1].newValue),
         Target = tostring(TargetResources[0].displayName)
| project TimeGenerated, Actor, Target, Role, CorrelationId
