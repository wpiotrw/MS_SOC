// title: Credentials added to applications or service principals
// date: 2026-10-19
// product: Entra
// tables: AuditLogs
// purpose: Threat Research: ConnectWise Cloud Backup (SkyKick): a vendor's multi-tenant app credential used to enter Microsoft 365 tenants
// source: https://www.huntress.com/blog/vendor-credential-enables-unauthorized-access
// kind: incident-note
// author: Threat Research analysis (a person)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
AuditLogs
| where TimeGenerated > datetime(2026-10-13)
| where OperationName has_any ("Add service principal credentials", "Certificates and secrets management")
| extend Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
         App = tostring(TargetResources[0].displayName)
| project TimeGenerated, OperationName, Actor, App, Result
