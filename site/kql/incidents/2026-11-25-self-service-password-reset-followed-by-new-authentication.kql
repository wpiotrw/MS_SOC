// title: Self-service password reset followed by new authentication methods (Microsoft Sentinel)
// date: 2026-11-25
// product: Entra
// tables: AuditLogs
// purpose: Threat Research: Beyond source code: a self-service password reset on one account led to Azure DevOps pipelines and Kubernetes credentials
// source: https://www.microsoft.com/en-us/security/blog/2026/09/29/beyond-source-code-a-path-to-the-keys-to-the-kingdom/
// kind: incident-note
// author: Threat Research analysis (the morning analysis)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// Storm-3068 SSPR to Azure DevOps - account takeover through self-service password reset
// Microsoft Sentinel; diagnostic category AuditLogs
let resets = AuditLogs
| where TimeGenerated > ago(30d)
| where LoggedByService == "Self-service Password Management" and OperationName has "reset" and Result == "success"
| extend User = tostring(TargetResources[0].userPrincipalName)
| project ResetTime = TimeGenerated, User, ResetOp = OperationName;
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName has_any ("registered security info", "User registered all required security info")
| extend User = tostring(TargetResources[0].userPrincipalName)
| project RegTime = TimeGenerated, User, RegOp = OperationName
| join kind=inner resets on User
| where RegTime between (ResetTime .. ResetTime + 24h)
| project User, ResetTime, ResetOp, RegTime, RegOp
