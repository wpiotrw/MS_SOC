// title: Flagged or clicked-through links clicked by privileged accounts (Defender XDR, 30 days)
// date: 2026-11-22
// product: Defender for Identity
// tables: IdentityInfo, UrlClickEvents
// purpose: Threat Research: Microsoft Entra Connect Health API flaw: attackers read administrator emails and tenant metadata (23 Jul - 19 Nov 2026)
// source: https://cybersecuritynews.com/microsoft-entra-connect-health-flaw/
// kind: incident-note
// author: Threat Research analysis (the morning analysis)
// archived by tools/kql_archive.py (CLAUDE.md 5l, 5eu)
// Entra Connect Health metadata leak (Nov 2026): link clicks by privileged accounts that Safe Links flagged or that were clicked through
// Defender XDR advanced hunting
let admins = IdentityInfo
| where Timestamp > ago(14d)
| where array_length(AssignedRoles) > 0
| distinct AccountUpn;
UrlClickEvents
| where Timestamp > ago(30d)
| where AccountUpn in~ (admins)
| where ThreatTypes has "Phish" or ActionType != "ClickAllowed" or IsClickedThrough == true
| project Timestamp, AccountUpn, Workload, Url, ActionType, ThreatTypes, IsClickedThrough, IPAddress, NetworkMessageId
| order by Timestamp desc
