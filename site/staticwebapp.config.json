{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "*.json",
      "/.auth/*",
      "/api/*",
      "/data/*",
      "/diff/*",
      "/history/*"
    ]
  },
  "globalHeaders": {
    "cache-control": "public, max-age=300, must-revalidate",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".html": "text/html"
  },
  "routes": [
    {
      "route": "/api/ms-status",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "public, max-age=60"
      }
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "owner"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    }
  ],
  "platform": {
    "apiRuntime": "node:22"
  }
}
